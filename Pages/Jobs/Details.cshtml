@page "{id:int}"
@model FixFlow.Pages.Jobs.DetailsModel
@{
    ViewData["Title"] = Model.Job.JobReference;
    var canManageOffice = User.IsInRole(UserRoles.OwnerAdmin) || User.IsInRole(UserRoles.FrontDesk);
    var canManageInventory = User.IsInRole(UserRoles.OwnerAdmin) || User.IsInRole(UserRoles.Technician);
}
<div class="page-heading job-heading"><div><p class="eyebrow">Job card</p><h1>@Model.Job.JobReference <span class="status status-@Model.Job.Status.ToString().ToLowerInvariant()">@JobWorkflowService.FormatStatus(Model.Job.Status)</span></h1><p class="muted">Received @Model.Job.ReceiveDate.ToString("dd MMM yyyy") · @Model.Job.Customer.FullName</p></div><div class="heading-actions"><a class="button button-secondary" asp-page="Print" asp-route-id="@Model.Job.Id" target="_blank">Print job card</a></div></div>

<section class="content-grid">
    <article class="panel span-two"><div class="panel-heading"><div><h2>Intake details</h2><p>@Model.Job.Equipment.Category @Model.Job.Equipment.Brand @Model.Job.Equipment.Model · @Model.Job.Equipment.SerialNumber</p></div><a asp-page="/Equipment/Details" asp-route-id="@Model.Job.EquipmentId">Equipment history</a></div><dl class="detail-list detail-list-wide"><dt>Customer</dt><dd><a asp-page="/Customers/Details" asp-route-id="@Model.Job.CustomerId">@Model.Job.Customer.FullName</a> · @Model.Job.Customer.PhoneNumber</dd><dt>Reported fault</dt><dd>@Model.Job.ReportedFault</dd><dt>Condition / accessories</dt><dd>@(Model.Job.ConditionAndAccessories ?? "Not recorded")</dd><dt>Expected completion</dt><dd>@(Model.Job.ExpectedCompletionDate?.ToString("dd MMM yyyy") ?? "Not set")</dd><dt>Assigned technician</dt><dd>@(Model.Job.Technician?.FullName ?? "Not assigned")</dd><dt>Internal intake notes</dt><dd>@(Model.Job.InternalNotes ?? "None")</dd></dl></article>
    <article class="panel"><h2>Move job forward</h2>
        @if (Model.AvailableStatuses.Count == 0) { <p class="empty-state">This job is closed and cannot be moved further.</p> } else { <form method="post" asp-page-handler="Transition" class="stack-form"><input type="hidden" name="id" value="@Model.Job.Id" /><label asp-for="StatusInput.NextStatus">Next status</label><select asp-for="StatusInput.NextStatus">@foreach (var status in Model.AvailableStatuses) { <option value="@status">@JobWorkflowService.FormatStatus(status)</option> }</select><label asp-for="StatusInput.Notes">Reason or update</label><textarea asp-for="StatusInput.Notes" rows="2"></textarea><button class="button" type="submit">Update status</button></form> }
    </article>
</section>

@if (User.IsInRole(UserRoles.OwnerAdmin))
{
    <section class="panel"><div class="panel-heading"><div><h2>Technician assignment</h2><p>Only the assigned technician can access this job from a technician account.</p></div></div><form method="post" asp-page-handler="AssignTechnician" class="inline-form"><input type="hidden" name="id" value="@Model.Job.Id" /><select asp-for="AssignmentInput.TechnicianId" asp-items="Model.TechnicianOptions"><option value="">Unassigned</option></select><button class="button button-secondary" type="submit">Save assignment</button></form></section>
}

<section class="content-grid">
    <article class="panel"><div class="panel-heading"><div><h2>Diagnosis notes</h2><p>Findings recorded by the workshop team.</p></div></div>
        @if (Model.Job.Notes.Count == 0) { <p class="empty-state">No diagnosis notes yet.</p> } else { <ul class="timeline">@foreach (var note in Model.Job.Notes.OrderByDescending(note => note.CreatedAtUtc)) { <li><div><strong>@note.CreatedByUser.FullName</strong> <span class="note-type">@(note.IsDiagnosis ? "Diagnosis" : "Update")</span><p>@note.NoteText</p></div><time>@note.CreatedAtUtc.ToLocalTime().ToString("dd MMM, HH:mm")</time></li> }</ul> }
        <form method="post" asp-page-handler="AddNote" class="stack-form inset-form"><input type="hidden" name="id" value="@Model.Job.Id" /><label asp-for="NoteInput.NoteText">Add note</label><textarea asp-for="NoteInput.NoteText" rows="3" placeholder="Record a finding or work update"></textarea><span asp-validation-for="NoteInput.NoteText" class="field-error"></span><label class="check-label"><input asp-for="NoteInput.IsDiagnosis" /> Diagnosis finding</label><button class="button button-secondary" type="submit">Add note</button></form>
    </article>
    <article class="panel"><div class="panel-heading"><div><h2>Estimate & approval</h2><p>Quote the repair before work begins.</p></div></div>
        @if (Model.Job.Estimate is not null) { <dl class="detail-list estimate-summary"><dt>Parts</dt><dd>@Model.Job.Estimate.PartsAmount.ToString("N2")</dd><dt>Labour</dt><dd>@Model.Job.Estimate.LabourAmount.ToString("N2")</dd><dt>Total</dt><dd><strong>@Model.Job.Estimate.TotalAmount.ToString("N2")</strong></dd><dt>Decision</dt><dd><span class="status">@Model.Job.Estimate.ApprovalStatus</span></dd></dl> }
        @if (canManageOffice) { <form method="post" asp-page-handler="SaveEstimate" class="form-grid compact-form"><input type="hidden" name="id" value="@Model.Job.Id" /><div><label asp-for="EstimateInput.PartsAmount">Estimated parts</label><input asp-for="EstimateInput.PartsAmount" value="@(Model.Job.Estimate?.PartsAmount)" /></div><div><label asp-for="EstimateInput.LabourAmount">Estimated labour</label><input asp-for="EstimateInput.LabourAmount" value="@(Model.Job.Estimate?.LabourAmount)" /></div><div class="full-width"><label asp-for="EstimateInput.Description">Estimate details</label><textarea asp-for="EstimateInput.Description" rows="2">@Model.Job.Estimate?.Description</textarea></div><button class="button button-secondary" type="submit">Save estimate</button></form>
            @if (Model.Job.Estimate is not null && Model.Job.Estimate.ApprovalStatus == ApprovalStatus.Pending) { <form method="post" asp-page-handler="RespondEstimate" class="inline-form response-form"><input type="hidden" name="id" value="@Model.Job.Id" /><select asp-for="ApprovalInput.Decision"><option value="Approved">Approve</option><option value="Rejected">Reject</option></select><input asp-for="ApprovalInput.ResponseNotes" placeholder="Customer response notes" /><button class="button" type="submit">Record response</button></form> }
        } else { <p class="field-hint">Office staff record estimates and customer approval.</p> }
    </article>
</section>

<section class="content-grid">
    <article class="panel"><div class="panel-heading"><div><h2>Parts used</h2><p>Inventory is reduced only when usage is recorded.</p></div></div>
        @if (Model.Job.PartsUsed.Count == 0) { <p class="empty-state">No parts used yet.</p> } else { <div class="table-wrap"><table><thead><tr><th>Part</th><th>Qty</th><th>Unit price</th><th>Total</th></tr></thead><tbody>@foreach (var usedPart in Model.Job.PartsUsed) { <tr><td>@usedPart.Part.Name<br /><span class="muted">@usedPart.Part.Sku</span></td><td>@usedPart.Quantity</td><td>@usedPart.UnitPrice.ToString("N2")</td><td>@usedPart.LineTotal.ToString("N2")</td></tr> }</tbody></table></div> }
        @if (canManageInventory && Model.Job.Status == RepairJobStatus.InProgress) { <form method="post" asp-page-handler="AddPart" class="inline-form inset-form"><input type="hidden" name="id" value="@Model.Job.Id" /><select asp-for="PartInput.PartId" asp-items="Model.PartOptions"><option value="">Select part</option></select><input asp-for="PartInput.Quantity" min="1" placeholder="Quantity" /><button class="button button-secondary" type="submit">Use part</button></form> } else if (canManageInventory) { <p class="field-hint">Move the job to In Progress after approval before recording parts.</p> }
    </article>
    <article class="panel"><div class="panel-heading"><div><h2>Payments</h2><p>Job total: <strong>@Model.JobTotal.ToString("N2")</strong> · Outstanding: <strong>@Model.OutstandingBalance.ToString("N2")</strong></p></div></div>
        @if (Model.Job.Payments.Count == 0) { <p class="empty-state">No payments recorded.</p> } else { <ul class="compact-list">@foreach (var payment in Model.Job.Payments.OrderByDescending(payment => payment.PaidAtUtc)) { <li><div><strong>@payment.Amount.ToString("N2")</strong><span>@payment.PaymentMethod · @payment.PaidAtUtc.ToLocalTime().ToString("dd MMM yyyy")</span></div><a asp-page="/Payments/Receipt" asp-route-id="@payment.Id" target="_blank">Receipt</a></li> }</ul> }
        @if (canManageOffice && Model.OutstandingBalance > 0) { <form method="post" asp-page-handler="RecordPayment" class="form-grid compact-form"><input type="hidden" name="id" value="@Model.Job.Id" /><div><label asp-for="PaymentInput.Amount"></label><input asp-for="PaymentInput.Amount" min="0.01" max="@Model.OutstandingBalance" /></div><div><label asp-for="PaymentInput.PaymentMethod">Method</label><select asp-for="PaymentInput.PaymentMethod"><option>Cash</option><option>Bank transfer</option></select></div><div class="full-width"><label asp-for="PaymentInput.Notes"></label><input asp-for="PaymentInput.Notes" placeholder="Optional reference or note" /></div><button class="button button-secondary" type="submit">Record payment</button></form> }
    </article>
</section>

<section class="panel"><div class="panel-heading"><div><h2>Status history</h2><p>Audit trail of workflow changes.</p></div></div><ul class="timeline">@foreach (var history in Model.Job.StatusHistory.OrderByDescending(item => item.ChangedAtUtc)) { <li><div><strong>@JobWorkflowService.FormatStatus(history.FromStatus) → @JobWorkflowService.FormatStatus(history.ToStatus)</strong><p>@history.Notes</p><span>@history.ChangedByUser.FullName</span></div><time>@history.ChangedAtUtc.ToLocalTime().ToString("dd MMM, HH:mm")</time></li> }</ul></section>
