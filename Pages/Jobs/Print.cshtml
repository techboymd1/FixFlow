@page "{id:int}"
@model FixFlow.Pages.Jobs.PrintModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@Model.Job.JobReference - FixFlow job card</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body class="print-page"><main class="print-sheet"><div class="print-header"><div class="brand"><span class="brand-mark">FF</span><span>FixFlow<small>Repair operations</small></span></div><div><h1>Repair job card</h1><strong>@Model.Job.JobReference</strong></div></div><section class="print-section"><div><span>Customer</span><strong>@Model.Job.Customer.FullName</strong><p>@Model.Job.Customer.PhoneNumber<br />@Model.Job.Customer.Email</p></div><div><span>Received</span><strong>@Model.Job.ReceiveDate.ToString("dd MMM yyyy")</strong><p>Expected: @(Model.Job.ExpectedCompletionDate?.ToString("dd MMM yyyy") ?? "Not set")</p></div><div><span>Status</span><strong>@JobWorkflowService.FormatStatus(Model.Job.Status)</strong><p>Technician: @(Model.Job.Technician?.FullName ?? "Unassigned")</p></div></section><section class="print-section single"><h2>Equipment</h2><p><strong>@Model.Job.Equipment.Category @Model.Job.Equipment.Brand @Model.Job.Equipment.Model</strong><br />Serial: @(Model.Job.Equipment.SerialNumber ?? "Not recorded") · Capacity: @(Model.Job.Equipment.Capacity ?? "Not recorded")</p></section><section class="print-section single"><h2>Reported fault</h2><p>@Model.Job.ReportedFault</p><h2>Condition and accessories received</h2><p>@(Model.Job.ConditionAndAccessories ?? "Not recorded")</p></section><section class="print-section single"><h2>Estimate</h2>@if (Model.Job.Estimate is null) { <p>Not yet prepared.</p> } else { <p>Parts: @Model.Job.Estimate.PartsAmount.ToString("N2") · Labour: @Model.Job.Estimate.LabourAmount.ToString("N2") · <strong>Total: @Model.Job.Estimate.TotalAmount.ToString("N2")</strong></p><p>Approval: @Model.Job.Estimate.ApprovalStatus</p> }</section><section class="signature-grid"><div>Customer signature</div><div>Received by</div></section></main><script>window.print();</script></body></html>
