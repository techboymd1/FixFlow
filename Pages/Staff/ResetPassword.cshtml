@page "{id:int}"
@model FixFlow.Pages.Staff.ResetPasswordModel
@{
    ViewData["Title"] = "Reset staff password";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">Staff administration</p>
        <h1>Reset password</h1>
        <p class="muted">Set a new password for @Model.StaffMember.FullName (@Model.StaffMember.UserName).</p>
    </div>
</div>

<form method="post" class="panel form-panel narrow-panel">
    <div asp-validation-summary="All" class="validation-summary"></div>

    <div class="stack-form">
        <div>
            <label asp-for="Input.Password">New password</label>
            <input asp-for="Input.Password" autocomplete="new-password" />
            <span asp-validation-for="Input.Password" class="field-error"></span>
        </div>
        <div>
            <label asp-for="Input.ConfirmPassword">Confirm new password</label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        </div>
    </div>

    <div class="form-actions">
        <a class="button button-quiet" asp-page="Index">Cancel</a>
        <button class="button" type="submit">Save new password</button>
    </div>
</form>
